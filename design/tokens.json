{
  "name": "Road Receipts",
  "description": "Quiet capture, irreverent copy and clear casework.",
  "colors": {
    "canvas": "#e8e3ed",
    "bg": "#f3f0f6",
    "surface": "#fcfafe",
    "ink": "#2b2531",
    "muted": "#615968",
    "line": "#d1c8d4",
    "soft": "#e8e3ec",
    "mint": "#dcefe3",
    "lilac": "#e8dcf0",
    "peach": "#f2dfd5",
    "accent": "#4e625a",
    "accent-soft": "#e4ece6",
    "violet": "#59475f",
    "warning": "#864a34",
    "warning-soft": "#f6e3d7",
    "danger": "#963c38",
    "danger-soft": "#f5dfdc",
    "tracking": "#f27969",
    "focus": "#674967",
    "on-dark": "#fff",
    "secondary-on-dark": "#d4e0e5",
    "dark": "#20282b",
    "field-edge": "#81727e",
    "field-error": "#925d45",
    "status-review": "#55327c",
    "status-sent": "#215841",
    "status-opened": "#294b83",
    "status-details": "#774009",
    "status-clear": "#544f61",
    "glow-lilac": "#e8d5ed",
    "glow-mint": "#d4ebdf",
    "glow-peach": "#efded2",
    "recording-black": "#000",
    "recording-text": "#eeeae4",
    "recording-hover": "#d8d1c8",
    "filter-selected": "#e4dbee",
    "recording-indicator": "#f16c69"
  },
  "typography": {
    "headline": {
      "fontFamily": "Manrope, Arial, sans-serif",
      "fontSize": "24px",
      "fontWeight": 700,
      "lineHeight": "31px",
      "letterSpacing": "-0.025em"
    },
    "home-headline": {
      "fontFamily": "Manrope, Arial, sans-serif",
      "fontSize": "27px",
      "fontWeight": 700,
      "lineHeight": "34px",
      "letterSpacing": "-0.025em"
    },
    "section-title": {
      "fontFamily": "Manrope, Arial, sans-serif",
      "fontSize": "16px",
      "fontWeight": 650,
      "lineHeight": "24px"
    },
    "body": {
      "fontFamily": "Manrope, Arial, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "label": {
      "fontFamily": "Manrope, Arial, sans-serif",
      "fontSize": "12px",
      "fontWeight": 650,
      "lineHeight": "18px"
    },
    "action": {
      "fontFamily": "Manrope, Arial, sans-serif",
      "fontSize": "14px",
      "fontWeight": 650,
      "lineHeight": 1.5
    },
    "navigation": {
      "fontFamily": "Manrope, Arial, sans-serif",
      "fontSize": "11px",
      "fontWeight": 650,
      "lineHeight": "17px"
    },
    "fact-input": {
      "fontFamily": "Manrope, Arial, sans-serif",
      "fontSize": "16px",
      "fontWeight": 550,
      "lineHeight": "24px"
    },
    "impact-number": {
      "fontFamily": "Manrope, Arial, sans-serif",
      "fontSize": "72px",
      "fontWeight": 750,
      "lineHeight": 1,
      "letterSpacing": "-0.035em"
    },
    "registration": {
      "fontFamily": "Manrope, Arial, sans-serif",
      "fontSize": "24px",
      "fontWeight": 750,
      "lineHeight": "32px",
      "letterSpacing": "0.02em"
    },
    "recording-message": {
      "fontFamily": "Manrope, Arial, sans-serif",
      "fontSize": "25px",
      "fontWeight": 550,
      "lineHeight": "35px",
      "letterSpacing": "-0.02em"
    }
  },
  "rounded": {
    "control": "12px",
    "capture-panel": "16px",
    "field": "10px",
    "quiet": "8px",
    "thumbnail": "7px",
    "segment": "6px",
    "badge": "5px",
    "frame-label": "4px",
    "track": "3px",
    "scrollbar": "2px",
    "preview-phone": "28px"
  },
  "spacing": {
    "4": "4px",
    "6": "6px",
    "8": "8px",
    "10": "10px",
    "12": "12px",
    "14": "14px",
    "16": "16px",
    "20": "20px",
    "22": "22px",
    "24": "24px"
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.ink}",
      "textColor": "{colors.on-dark}",
      "rounded": "{rounded.control}",
      "typography": "{typography.action}",
      "padding": "12px 16px"
    },
    "button-primary-hover": {
      "backgroundColor": "{colors.accent}"
    },
    "button-secondary": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.ink}",
      "rounded": "{rounded.control}",
      "typography": "{typography.action}",
      "padding": "12px 16px"
    },
    "button-disabled": {
      "backgroundColor": "{colors.soft}",
      "textColor": "{colors.muted}"
    },
    "field": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.ink}",
      "rounded": "{rounded.field}",
      "typography": "{typography.body}",
      "padding": "12px"
    },
    "inline-fact": {
      "textColor": "{colors.ink}",
      "typography": "{typography.fact-input}"
    },
    "field-missing": {
      "backgroundColor": "{colors.warning-soft}",
      "textColor": "{colors.warning}"
    },
    "navigation": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.muted}",
      "typography": "{typography.navigation}",
      "height": "82px",
      "padding": "5px 8px 12px"
    },
    "repeat-plate": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.ink}",
      "rounded": "{rounded.control}",
      "padding": "16px"
    },
    "repeat-plate-selected": {
      "backgroundColor": "{colors.accent-soft}"
    },
    "case-row": {
      "textColor": "{colors.ink}",
      "rounded": "{rounded.quiet}",
      "padding": "16px 12px"
    },
    "case-row-hover": {
      "backgroundColor": "{colors.soft}"
    },
    "status-review": {
      "textColor": "{colors.status-review}",
      "typography": "{typography.label}"
    },
    "status-sent": {
      "textColor": "{colors.status-sent}",
      "typography": "{typography.label}"
    },
    "status-opened": {
      "textColor": "{colors.status-opened}",
      "typography": "{typography.label}"
    },
    "status-details": {
      "textColor": "{colors.status-details}",
      "typography": "{typography.label}"
    },
    "status-clear": {
      "textColor": "{colors.status-clear}",
      "typography": "{typography.label}"
    }
  }
}
