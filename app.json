{
  "expo": {
    "name": "Click-to-Safe",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.safetycar.dev",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ],
        "NSCameraUsageDescription": "Record your drive to review possible road incidents.",
        "NSMicrophoneUsageDescription": "Include audio in your road incident recording."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f3f0f6"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.example.safetycar.dev"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "safetycar-dev",
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Click-to-Safe to record road incidents.",
          "microphonePermission": "Allow Click-to-Safe to record video audio.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a dashcam video to review.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "./plugins/withWhatsApp",
      "expo-font",
      "./plugins/withNoPushEntitlement",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 146
        }
      ]
    ]
  }
}
