{
  "expo": {
    "name": "DriveReport",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080d13"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.safetycar.dev",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ],
        "NSCameraUsageDescription": "Record a short road incident for review.",
        "NSMicrophoneUsageDescription": "Include audio in your road incident recording."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.example.safetycar.dev"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "safetycar-dev",
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DriveReport to record road incidents.",
          "microphonePermission": "Allow DriveReport to record video audio.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a dashcam video to review.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "./plugins/withWhatsApp",
      "expo-font",
      "./plugins/withNoPushEntitlement"
    ]
  }
}
