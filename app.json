{
  "expo": {
    "name": "Click-to-Safe",
    "slug": "click-to-safe",
    "owner": "yuyu-corp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.aibuildercup.clicktosafe2",
      "buildNumber": "9",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ],
        "NSCameraUsageDescription": "Record your drive to review possible road incidents.",
        "NSMicrophoneUsageDescription": "Include audio in your road incident recording.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f3f0f6"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.example.safetycar.dev"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "safetycar-dev",
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location to prefill the incident location. You can edit it before sharing.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Click-to-Safe to record road incidents.",
          "microphonePermission": "Allow Click-to-Safe to record video audio.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a dashcam video to review.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "./plugins/withWhatsApp",
      "expo-font",
      "./plugins/withNoPushEntitlement",
      "./plugins/withPodDeploymentTarget",
      "./plugins/withSceneLifecycle",
      "./plugins/withCameraReadiness",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 146
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf9e5ab8-8b00-405e-8f56-87fed2ec2910"
      }
    }
  }
}
